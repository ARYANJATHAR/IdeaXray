# Copy this file to .env
SERPAPI_API_KEY=
AI_PROVIDER=azure
# Azure OpenAI is the only AI provider. Keep its key server-only.
# Endpoint: https://YOUR-RESOURCE.openai.azure.com (or its /openai/v1/ URL).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Your deployed GPT-5 mini deployment name.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini-1
# GPT-5 mini: low limits reasoning cost/latency. Leave blank for non-reasoning models.
AZURE_OPENAI_REASONING_EFFORT=low

# Prisma Postgres (Vercel Marketplace injects DATABASE_URL after connecting the database)
# For local development, use a Prisma Postgres development database or local PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_URL=http://localhost:3000

SEARCH_TIMEOUT_MS=30000
AI_TIMEOUT_MS=60000
AI_TASK_TIMEOUT_MS=45000
MIN_SERPAPI_CREDITS=6
MAX_SEARCHES_PER_ANALYSIS=6
RELEVANCE_THRESHOLD=18
RATE_LIMIT_PER_HOUR=10
GLOBAL_ANALYSES_PER_HOUR=20
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_TIMEOUT_MS=240000

# Optional AI interpretation after source collection; research also works without AI keys.
AI_ENRICHMENT=true
