# Copy this file to .env
SERPAPI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free,qwen/qwen3.8-27b:free,z-ai/glm-5.2:free

# Local SQLite database (created automatically on migrate)
DATABASE_URL=file:./dev.db
APP_URL=http://localhost:3000

SEARCH_TIMEOUT_MS=30000
AI_TIMEOUT_MS=60000
AI_TASK_TIMEOUT_MS=25000
MIN_SERPAPI_CREDITS=6
MAX_SEARCHES_PER_ANALYSIS=6
RELEVANCE_THRESHOLD=18
RATE_LIMIT_PER_HOUR=10
GLOBAL_ANALYSES_PER_HOUR=20
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_TIMEOUT_MS=240000

# Optional AI interpretation after source collection; research also works without AI keys.
AI_ENRICHMENT=true
