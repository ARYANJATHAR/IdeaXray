# Copy this file to .env
SERPAPI_API_KEY=
# NVIDIA is the default and exclusive AI provider. Keep its key server-only.
AI_PROVIDER=nvidia
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Add your NVIDIA key below. Set AI_PROVIDER=gemini to use Google instead.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b,moonshotai/kimi-k3,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_MS=12000
# Legacy fallback chain is used only with AI_PROVIDER=fallback.
# FREEAI_API_KEY=
# FREEAI_MODEL=qwen7b
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free,qwen/qwen3.8-27b:free,z-ai/glm-5.2:free

# Prisma Postgres (Vercel Marketplace injects DATABASE_URL after connecting the database)
# For local development, use a Prisma Postgres development database or local PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_URL=http://localhost:3000

SEARCH_TIMEOUT_MS=30000
AI_TIMEOUT_MS=60000
AI_TASK_TIMEOUT_MS=45000
MIN_SERPAPI_CREDITS=6
MAX_SEARCHES_PER_ANALYSIS=6
RELEVANCE_THRESHOLD=18
RATE_LIMIT_PER_HOUR=10
GLOBAL_ANALYSES_PER_HOUR=20
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_TIMEOUT_MS=240000

# Optional AI interpretation after source collection; research also works without AI keys.
AI_ENRICHMENT=true
